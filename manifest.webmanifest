{"name":"LibreCorsa","short_name":"LibreCorsa","description":"Free, open-source sim racing in your browser: 500 Hz physics, open-wheelers and a GT3, AI races, multiplayer and wheel force feedback. Nothing to install.","start_url":"/play","scope":"/","display":"fullscreen","orientation":"landscape","background_color":"#08090D","theme_color":"#08090D","categories":["games","sports"],"icons":[{"src":"/branding/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/branding/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/branding/librecorsa-mark.svg","sizes":"any","type":"image/svg+xml"}]}